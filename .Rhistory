library(miceadds)
library(openMSE)
library(abind)
#library(mahiMSE)
setwd("C:/Github/DolphinMSE")
source.all("code/Source")
largedir = "C:/Users/tcar_/Dropbox/temp/Dolphin_postPR"
# --- Reference Grid of OMs ----------------------------------------------------
ref_grid = readRDS('OMs/ref_grid.rds')
# --- Movement matrices --------------------------------------------------------
movs = list(GLM= readRDS('OMs/mov_matrices/mov_GLM_60.rds'),
VAST = readRDS('OMs/mov_matrices/mov_VAST_60.rds')) # names match levels in ref_grid and cond_grid
# --- Catch datasets -----------------------------------------------------------
# dist = readRDS('data/VASTdist.rds')                           # a matrix of historical distributions (n time step x narea)
# index = readRDS('data/VASTindex.rds')
mincatch = 10 # 10 kg min
C_yfr_h = readRDS("data/Catches_2026/C_yfr_h.rds"); C_yfr_h[C_yfr_h < mincatch | is.na(C_yfr_h)] = mincatch
C_yfr_l = readRDS("data/Catches_2026/C_yfr_l.rds"); C_yfr_l[C_yfr_l < mincatch | is.na(C_yfr_l)] = mincatch
fleetnames = dimnames(C_yfr_h)[[2]]
C_yfr_list = list(C_yfr_l, C_yfr_h)
names(C_yfr_list) = c("L", "H")                                 # names match levels in ref_grid and cond_grid
saveRDS(C_yfr_list,"OMs/C_yfr_list.rds")
# Distribution datasets
GLM_dist = readRDS('data/GLM_dist.rds')             # a matrix of historical distributions (n time step x narea)
VAST_dist = readRDS('data/VAST_dist.rds')           # a matrix of historical distributions (n time step x narea)
dist_list = list(GLM = GLM_dist, VAST = VAST_dist)
fits = readRDS(paste0(largedir,'/fits/fits_Oct_19_2026.rds'))  # lapply(fits, function(x)x@OM@cpars$hs[1])
OM_list = readRDS(paste0(largedir,'/fits/OM_list_Oct_19_2026.rds'))
RefOMs_wI = readRDS(paste0(largedir,'/spatial/RefOMs_wI_Oct_26_2026.rds'))
OMnames = sapply(RefOMs_wI,function(x)x@Name)
outdir = "C:/Github/DolphinMSE/OMs/Reference_set"
for(rr in 1:nrow(ref_grid)){
RecLev = ref_grid[rr,4] # which recruitment level to add
OM = make_rec(RefOMs_wI[[rr]],RecLev) # projected (subject to RecLev) and initial spool-up recruitments
# -------------------------------------------
# Add seasonality
# nYear(OM);  #Years(OM);  #Years(OMtest) #needs OM@Seasons
# OMtest = OM
# OMtest@Seasons=4
# Years(OMtest,Period='H')
# OM = make_seasonal(OM)
# -------------------------------------------
fit =fits[[rr]]
OM@Name = paste0("RefOM #",rr,": ",paste(ref_grid[rr,],collapse="-"))
OM@Interval = 1
OM@Control$DataOM <- list(Effort=TRUE, Number=TRUE, SBiomass = TRUE,  # What information should be passed from the OM to the Data object used by the MP?
Biomass = TRUE, Distribution = TRUE, OM = TRUE)
#'OM@Stock@Weight', 'OM@Stock@Length',
#'OM@Fleet@Selectivity', 'OM@Name')
OM = Rename(OM,Fleets = c("USCom","RecN","RecS","HireN","HireS","Intl"))
# save
OMlab = paste("OM",rr,sep="_")
assign(OMlab,OM)
do.call('save',args = list(OMlab,file=paste0(outdir,"/",OMlab,".RData")))
}
