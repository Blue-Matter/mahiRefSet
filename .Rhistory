library(mahiMSE)
library(mahiRefSet)
library(ggplot2)
packageVersion('mahiMSE')
packageVersion('mahiRefSet')
# === Take a look at the new Index set up (package object Indices) =============
ggplot(data=Indices, aes(x=Year, y=Index, group=Name)) +
geom_line(aes(color=Name)) +
geom_point(aes(color=Name))
# === AM3 MPs ==================================================================
USnoncomm = USprivate = UShirecharter = rep(NA,length(Fleets))
USnoncomm[match(c("RecN",  "RecS",  "HireN", "HireS"), Fleets)] = 1
USprivate[match(c("RecN",  "RecS"), Fleets)] = 1
UShirecharter[match(c("HireN", "HireS"), Fleets)] = 1
# === Make Min Size and Trip Limit MPs =========================================
# Copy mahiMP
SQM = EMSL = RVL12 = RVL24 = RVL36 = RVL48 =
RVL12p = RVL12f = RVL36p = RVL36f = mahiMP
# EMSL: 20" min FL for all commercial and private
formals(EMSL)$SLmin = c(500, 500, 500, 500, 500, 0, 0, 0)
# RVL12: 12 fish across private, charter and headboat vessels
formals(RVL12)$TL = 12 * USnoncomm
# RVL24: 24 fish across private, charter and headboat vessels
formals(RVL12)$TL = 24 * USnoncomm
# RVL36: 36 fish across private, charter and headboat vessels
formals(RVL36)$TL = 36 * USnoncomm
# RVL48: 48 fish across private, charter and headboat vessels
formals(RVL48)$TL = 48 * USnoncomm
# RVL12p: 12 fish across private vessels
formals(RVL12p)$TL = 12 * USprivate
# RVL12f: 12 fish for hire (charter / headboat)
formals(RVL12f)$TL = 12 * UShirecharter
# RVL36p: 36 fish across private vessels
formals(RVL36p)$TL = 36 * USprivate
# RVL36f: 36 fish for hire (charter / headboat)
formals(RVL36f)$TL = 36 * UShirecharter
# Assign class MP
class(EMSL) = class(RVL12) = class(RVL24) = class(RVL36) = class(RVL48) =
class(RVL12p) = class(RVL12f) = class(RVL36p) =
class(RVL36p) = 'mp'
MPs = c("SQM", "EMSL","RVL12", "RVL24", "RVL36", "RVL48",
"RVL12p", "RVL12f", "RVL36p", "RVL36p")
if(dotest){
testAM3 = Project(hist, MPs)
saveRDS(testAM3, "C:/Users/tcar_/Dropbox/mahiMSE/smallMSE_v09_13/smallAM3.rds")
mahiplot(testAM3)
test1 = Simulate(OM_1, nSim = 2)
system.time({MSE_test1 = Project(test1, MPs)})
test2 = Simulate(OM_1, nSim = 3)
system.time({MSE_test2 = Project(test2, MPs)})
test3 = Simulate(OM_1, nSim = 5)
system.time({MSE_test3 = Project(test3, MPs)})
