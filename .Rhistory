# === Make Min Size and Trip Limit MPs =========================================
# Copy mahiMP
SQM = EMSL = RVL12 = RVL24 = RVL36 = RVL48 =
RVL12p = RVL12f = RVL36p = RVL36f = mahiMP
# EMSL: 20" min FL for all commercial and private
formals(EMSL)$SLmin = c(500, 500, 500, 500, 500, 0, 0, 0)
# RVL12: 12 fish across private, charter and headboat vessels
formals(RVL12)$TL = 12 * USnoncomm
# RVL24: 24 fish across private, charter and headboat vessels
